generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SYSTEM
  NEWSLETTER
  CUSTOMER_SERVICE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum PaymentMethod {
  ZARINPAL
  IDPAY
  CASH
  CARD
  WALLET
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum ProductAttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
  MULTI_SELECT
  JSON
  DATE
}

enum ProductAttributeInputType {
  TEXT
  TEXTAREA
  NUMBER
  SWITCH
  SELECT
  MULTI_SELECT
  DATE
  COLOR
  RICH_TEXT
}

enum ProductAttributeTemplateScope {
  CATEGORY
  PRODUCT_TYPE
  BRAND_PRODUCT_TYPE
  PRODUCT_MODEL
}

// Models

model User {
  id       String  @id @default(cuid())
  email    String? @unique
  phone    String? @unique
  password String?

  firstName String?
  lastName  String?
  avatarUrl String?

  status UserStatus @default(ACTIVE)
  roleId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  role          Role?            @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  addresses     Address[]
  sessions      UserSession[]
  orders        Order[]
  reviews       ProductReview[]
  cart          Cart?
  wishlist      Wishlist?
  payments      Payment[]
  events        Event[]
  conversations AIConversation[]
  couponUsages  CouponUsage[]
  notifications Notification[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([roleId])
  @@index([deletedAt])
  @@ignore
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]
  users           User[]           @ignore

  @@index([deletedAt])
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) @ignore

  @@index([userId])
  @@index([expiresAt])
}

model UserSession {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) @ignore

  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
}

model PhoneOtp {
  id String @id @default(uuid())

  phone    String
  purpose  String @default("CUSTOMER_LOGIN")
  codeHash String

  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([createdAt])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  title      String?
  firstName  String
  lastName   String
  phone      String
  country    String
  state      String?
  city       String
  postalCode String?
  street     String
  apartment  String?
  isDefault  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user           User    @relation(fields: [userId], references: [id]) @ignore
  shippingOrders Order[] @relation("ShippingAddress") @ignore
  billingOrders  Order[] @relation("BillingAddress") @ignore

  @@index([userId])
  @@index([country])
  @@index([city])
  @@index([deletedAt])
}

model Category {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String    @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  parentId       String?   @map("parent_id")
  image          String?
  iconUrl        String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  parent             Category?                  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories      Category[]                 @relation("SubCategories")
  productTypes       ProductType[]
  attributeTemplates ProductAttributeTemplate[]
  products           Product[]                  @ignore

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Brand {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String    @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  logoUrl        String?
  website        String?
  country        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  productModels      ProductModel[]
  attributeTemplates ProductAttributeTemplate[]
  products           Product[]                  @ignore

  @@index([isActive])
  @@index([deletedAt])
}

model ProductType {
  id             String    @id @default(uuid())
  categoryId     String
  name           String
  slug           String
  description    String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  category  Category                   @relation(fields: [categoryId], references: [id])
  models    ProductModel[]
  templates ProductAttributeTemplate[]
  products  Product[]                  @ignore

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model ProductModel {
  id            String    @id @default(uuid())
  brandId       String
  productTypeId String
  name          String
  modelCode     String?
  slug          String
  description   String?
  titlePattern  String?
  seoPattern    String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @map("deleted_at")

  brand       Brand                      @relation(fields: [brandId], references: [id])
  productType ProductType                @relation(fields: [productTypeId], references: [id])
  templates   ProductAttributeTemplate[]
  products    Product[]                  @ignore

  @@unique([brandId, productTypeId, slug])
  @@index([brandId])
  @@index([productTypeId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model ProductAttributeTemplate {
  id             String                        @id @default(uuid())
  scope          ProductAttributeTemplateScope
  name           String
  categoryId     String?
  productTypeId  String?
  brandId        String?
  productModelId String?
  priority       Int                           @default(100)
  isDefault      Boolean                       @default(false)
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  deletedAt      DateTime?                     @map("deleted_at")

  category     Category?                       @relation(fields: [categoryId], references: [id])
  productType  ProductType?                    @relation(fields: [productTypeId], references: [id])
  brand        Brand?                          @relation(fields: [brandId], references: [id])
  productModel ProductModel?                   @relation(fields: [productModelId], references: [id])
  fields       ProductAttributeTemplateField[]

  @@index([scope])
  @@index([categoryId])
  @@index([productTypeId])
  @@index([brandId])
  @@index([productModelId])
  @@index([priority])
  @@index([isDefault])
  @@index([isActive])
  @@index([deletedAt])
}

model ProductAttributeTemplateField {
  id          String   @id @default(uuid())
  templateId  String
  attributeId String
  groupName   String?
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template  ProductAttributeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attribute Attribute                @relation(fields: [attributeId], references: [id])

  @@unique([templateId, attributeId])
  @@index([templateId])
  @@index([attributeId])
  @@index([sortOrder])
}

model Product {
  id String @id @default(uuid())

  name             String
  slug             String  @unique
  description      String?
  shortDescription String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  schemaJson     Json?

  brandId        String
  categoryId     String
  productTypeId  String?
  productModelId String?

  sku String @unique

  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)

  purchasePrice      Decimal? @db.Decimal(12, 2)
  salePrice          Decimal? @db.Decimal(12, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  finalPrice         Decimal? @db.Decimal(12, 2)
  minAllowedPrice    Decimal? @db.Decimal(12, 2)
  grossMarginAmount  Decimal? @db.Decimal(12, 2)
  grossMarginPercent Decimal? @db.Decimal(6, 2)

  weight     Float?
  dimensions Json?

  isActive Boolean       @default(true)
  status   ProductStatus @default(DRAFT)

  aiContentStatus String   @default("NOT_GENERATED")
  aiQualityScore  Decimal? @db.Decimal(5, 2)

  viewCount     Int      @default(0)
  reviewCount   Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  brand        Brand         @relation(fields: [brandId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  productType  ProductType?  @relation(fields: [productTypeId], references: [id])
  productModel ProductModel? @relation(fields: [productModelId], references: [id])

  variants   ProductVariant[]
  images     ProductImage[]
  attributes ProductAttribute[]

  reviews       ProductReview[]      @ignore
  cartItems     CartItem[]
  orderItems    OrderItem[]
  productTags   ProductTagRelation[]
  wishlistItems WishlistItem[]

  collectionProducts  CollectionProduct[]  @ignore
  homeSectionProducts HomeSectionProduct[] @ignore

  @@index([brandId])
  @@index([categoryId])
  @@index([productTypeId])
  @@index([productModelId])
  @@index([status, isActive])
  @@index([price])
  @@index([finalPrice])
  @@index([name])
  @@index([slug])
  @@index([createdAt])
  @@index([deletedAt])
  @@ignore
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) @ignore

  sku     String  @unique
  name    String?
  slug    String?
  barcode String? @unique
  gtin    String? @unique
  mpn     String?

  price        Decimal? @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)

  weight     Float?
  dimensions Json?   @ignore
  imageUrl   String?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false) @ignore

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  inventories       Inventory[]
  variantAttributes VariantAttribute[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([slug])
  @@index([barcode])
  @@index([gtin])
  @@index([mpn])
  @@index([isActive])
  @@index([deletedAt])
}

model ProductImage {
  id           String           @id @default(uuid())
  productId    String
  type         ProductMediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  altText      String?
  title        String?
  caption      String?
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  duration     Int?
  sortOrder    Int              @default(0)
  isPrimary    Boolean          @default(false)
  isActive     Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade) @ignore

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
  @@index([isPrimary])
  @@index([isActive])
}

model Attribute {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String? @unique
  label       String?
  description String?

  dataType  ProductAttributeDataType  @default(TEXT)
  inputType ProductAttributeInputType @default(TEXT)

  unit        String?
  optionsJson Json    @default("[]")
  placeholder String?
  helpText    String?

  isRequired     Boolean @default(false)
  isFilterable   Boolean @default(false)
  isComparable   Boolean @default(false)
  isSeoImportant Boolean @default(false)
  isAiImportant  Boolean @default(true)
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  values            AttributeValue[]
  variantAttributes VariantAttribute[]
  productAttributes ProductAttribute[]
  templateFields    ProductAttributeTemplateField[]

  @@index([code])
  @@index([dataType])
  @@index([inputType])
  @@index([isFilterable])
  @@index([isComparable])
  @@index([isSeoImportant])
  @@index([isAiImportant])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String
  value       String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  attribute Attribute @relation(fields: [attributeId], references: [id])

  variants VariantAttribute[]
  products ProductAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@index([value])
  @@index([deletedAt])
}

model ProductAttribute {
  id               String   @id @default(uuid())
  productId        String
  attributeId      String?
  attributeValueId String?
  valueText        String?
  valueNumber      Decimal? @db.Decimal(14, 4)
  valueBoolean     Boolean?
  valueJson        Json?
  unit             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade) @ignore
  attribute      Attribute?      @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id])

  @@unique([productId, attributeId])
  @@unique([productId, attributeValueId])
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

model VariantAttribute {
  id String @unique @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeId String?
  attribute   Attribute? @relation(fields: [attributeId], references: [id])

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  createdAt DateTime @default(now())

  @@id([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeId])
  @@index([attributeValueId])
}

model ProductReview {
  id         String  @id @default(uuid())
  userId     String
  productId  String
  rating     Int     @db.SmallInt
  title      String?
  comment    String?
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id]) @ignore
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade) @ignore

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([rating])
  @@index([isVerified])
}

model ProductTag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  productTags ProductTagRelation[]

  @@index([name])
  @@index([slug])
  @@index([deletedAt])
}

model ProductTagRelation {
  productId String
  tagId     String

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade) @ignore
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade) @ignore
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  variantId String?

  quantity Int     @default(1)
  price    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id]) @ignore
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id]) @ignore
  items WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String
  productId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id]) @ignore

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  subtotal       Decimal @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(12, 2)
  shippingAmount Decimal @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0.00) @db.Decimal(12, 2)

  currency      String         @default("IRR")
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  shippingAddressId String?
  billingAddressId  String?
  shippingMethod    String?
  trackingNumber    String?
  notes             String?

  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user            User         @relation(fields: [userId], references: [id]) @ignore
  items           OrderItem[]
  payments        Payment[]
  couponUsage     CouponUsage?
  shippingAddress Address?     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?     @relation("BillingAddress", fields: [billingAddressId], references: [id])
  invoice         Invoice?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([totalAmount])
  @@index([userId, status])
  @@index([deletedAt])
  @@ignore
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?

  quantity    Int     @default(1)
  price       Decimal @default(0.00) @db.Decimal(12, 2)
  productName String
  sku         String
  discount    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id]) @ignore
  product Product         @relation(fields: [productId], references: [id]) @ignore
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId, variantId])
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id      String @id @default(uuid())
  orderId String
  userId  String

  amount   Decimal @default(0.00) @db.Decimal(12, 2)
  currency String  @default("IRR")

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  transactionId String?
  gateway       String?
  receiptUrl    String?
  metadata      Json?

  gatewayAuthority          String?   @unique
  gatewayRequestKey         String?   @unique
  gatewayRequestState       String?
  gatewayRequestedAt        DateTime?
  gatewayRequestCompletedAt DateTime?

  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade) @ignore
  user  User  @relation(fields: [userId], references: [id]) @ignore

  refunds Refund[]
  invoice Invoice?

  @@index([orderId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([gatewayRequestState])
  @@index([gatewayRequestedAt])
  @@index([deletedAt])
  @@ignore
}

model Invoice {
  id        String @id @default(uuid())
  orderId   String @unique
  paymentId String @unique

  invoiceNumber String @unique

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  amount   Decimal @default(0.00) @db.Decimal(12, 2)
  currency String  @default("IRR")

  status InvoiceStatus @default(PENDING)

  pdfUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  order   Order   @relation(fields: [orderId], references: [id]) @ignore
  payment Payment @relation(fields: [paymentId], references: [id]) @ignore

  @@index([invoiceNumber])
  @@index([status])
  @@index([deletedAt])
}

model Refund {
  id        String       @id @default(uuid())
  paymentId String
  amount    Decimal      @default(0.00) @db.Decimal(12, 2)
  reason    String?
  status    RefundStatus @default(PENDING)

  processedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

