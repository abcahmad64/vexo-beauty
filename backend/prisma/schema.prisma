  decision  String
  reason    String?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([ipAddress])
  @@index([action])
  @@index([decision])
  @@index([createdAt])
  @@index([deletedAt])
}

model AdminImportJob {
  id           String    @id @default(uuid())
  entity       String
  mode         String    @default("UPSERT")
  sourceFormat String    @default("JSON")
  status       String    @default("PENDING")
  title        String?
  rowCount     Int       @default(0)
  successCount Int       @default(0)
  failureCount Int       @default(0)
  rowsJson     Json      @default("[]")
  previewJson  Json      @default("{}")
  resultJson   Json      @default("{}")
  errorMessage String?
  createdById  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? @map("deleted_at")

  @@index([entity])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

model AdminExportJob {
  id           String    @id @default(uuid())
  entity       String
  format       String    @default("JSON")
  status       String    @default("PENDING")
  title        String?
  filtersJson  Json      @default("{}")
  resultJson   Json      @default("{}")
  fileUrl      String?
  errorMessage String?
  createdById  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? @map("deleted_at")

  @@index([entity])
  @@index([format])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

model EventOutbox {
  id          String       @id @default(uuid())
  aggregateId String
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([aggregateId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AdminProductCreateRequest {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  actorId            String
  productId          String   @unique
  payloadFingerprint String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([actorId])
  @@index([createdAt])
}

model CatalogResearchRun {
  id                 String    @id @default(uuid())
  productId          String?
  brandId            String?
  productModelId     String?
  triggerType        String
  scope              String    @default("PRODUCT")
  status             String    @default("PENDING")
  requestedById      String?
  requestedQuery     String?
  normalizedIdentity Json      @default("{}")
  progressJson       Json      @default("{}")
  summaryJson        Json      @default("{}")
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? @map("deleted_at")

  sources     CatalogResearchSource[]
  suggestions CatalogResearchFieldSuggestion[]

  @@index([productId])
  @@index([brandId])
  @@index([productModelId])
  @@index([triggerType])
  @@index([scope])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model CatalogResearchSource {
  id            String    @id @default(uuid())
  researchRunId String
  sourceType    String
  sourceUrl     String
  canonicalUrl  String?
  domain        String?
  title         String?
  language      String?
  publisher     String?
  publishedAt   DateTime?
  retrievedAt   DateTime  @default(now())
  httpStatus    Int?
  contentHash   String?
  extractedText String?
  metadataJson  Json      @default("{}")
  trustScore    Decimal?  @db.Decimal(5, 2)
  verification  String    @default("UNVERIFIED")
  isOfficial    Boolean   @default(false)
  isAccessible  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @map("deleted_at")

  researchRun CatalogResearchRun               @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  suggestions CatalogResearchFieldSuggestion[]

  @@unique([researchRunId, sourceUrl])
  @@index([researchRunId])
  @@index([sourceType])
  @@index([domain])
  @@index([verification])
  @@index([isOfficial])
  @@index([retrievedAt])
  @@index([deletedAt])
}

model CatalogResearchFieldSuggestion {
  id                 String    @id @default(uuid())
  researchRunId      String
  sourceId           String?
  productId          String?
  fieldPath          String
  normalizedValue    Json
  displayValue       String?
  unit               String?
  sourceExcerpt      String?
  confidence         Decimal   @default(0.00) @db.Decimal(5, 2)
  verificationStatus String    @default("PENDING")
  conflictGroup      String?
  adminDecision      String    @default("PENDING")
  adminNote          String?
  reviewedById       String?
  reviewedAt         DateTime?
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? @map("deleted_at")

  researchRun CatalogResearchRun     @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  source      CatalogResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([researchRunId])
  @@index([sourceId])
  @@index([productId])
  @@index([fieldPath])
  @@index([verificationStatus])
  @@index([adminDecision])
  @@index([confidence])
  @@index([deletedAt])
}

model CatalogApprovedKnowledge {
  id                 String    @id @default(uuid())
  productId          String?
  brandId            String?
  productModelId     String?
  fieldPath          String
  normalizedValue    Json
  displayValue       String?
  unit               String?
  sourceSuggestionId String?
  sourceUrlsJson     Json      @default("[]")
  confidence         Decimal   @default(0.00) @db.Decimal(5, 2)
  approvedById       String
  approvedAt         DateTime  @default(now())
  version            Int       @default(1)
  isCurrent          Boolean   @default(true)
  expiresAt          DateTime?
  metadataJson       Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? @map("deleted_at")

  @@index([productId])
  @@index([brandId])
  @@index([productModelId])
  @@index([fieldPath])
  @@index([isCurrent])
  @@index([expiresAt])
  @@index([approvedAt])
  @@index([deletedAt])
}

model CatalogDiscoveredProduct {
  id                  String    @id @default(uuid())
  brandId             String?
  sourceResearchRunId String?
  normalizedName      String
  displayName         String
  brandName           String?
  modelCode           String?
  productFamily       String?
  categoryHint        String?
  productTypeHint     String?
  officialUrl         String?
  identifiersJson     Json      @default("{}")
  summaryJson         Json      @default("{}")
  evidenceJson        Json      @default("[]")
  completenessScore   Decimal?  @db.Decimal(5, 2)
  confidence          Decimal?  @db.Decimal(5, 2)
  status              String    @default("DISCOVERED")
  importProductId     String?
  lastResearchedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime? @map("deleted_at")

  @@index([brandId])
  @@index([modelCode])
  @@index([productFamily])
  @@index([status])
  @@index([confidence])
  @@index([lastResearchedAt])
  @@index([deletedAt])
}
